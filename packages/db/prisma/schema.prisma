generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  VIEWER
}

enum StreamStatus {
  PENDING
  CAPTURING
  PAUSED
  ENDED
  FAILED
  RETRYING
  STOPPED
}

enum StreamRecoveryStatus {
  WAITING
  RUNNING
  FAILED
  ACKNOWLEDGED
  RECOVERED
}

enum MessageType {
  NORMAL
  SUPERCHAT
  MEMBERSHIP
  PINNED
  MODERATOR
  OWNER
  SYSTEM
}

enum CaptureSessionStatus {
  RUNNING
  STOPPED
  FAILED
}

enum ExportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ExportFormat {
  PDF
  CSV
  EXCEL
  JSON
}

enum ExportJobType {
  FULL_STREAM
  FILTERED_CHAT
  USER_CHAT
  DATE_RANGE
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String          @unique
  name         String
  passwordHash String          @map("password_hash")
  role         UserRole        @default(ADMIN)
  isActive     Boolean         @default(true) @map("is_active")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  streams      Stream[]        @relation("StreamCreator")
  auditLogs    AuditLog[]
  exportJobs   ExportJob[]
  notificationEvents NotificationEvent[] @relation("NotificationEventCreator")
  pushDevices  PushDevice[]
  settings     SystemSetting[]
  userUpdateWatches UserUpdateWatch[]

  @@map("users")
}

model Stream {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  videoId         String           @map("video_id")
  channelId       String?          @map("channel_id")
  title           String?
  status          StreamStatus     @default(PENDING)
  liveChatUrl     String?          @map("live_chat_url")
  retryCount      Int              @default(0) @map("retry_count")
  recoveryStatus  StreamRecoveryStatus? @map("recovery_status")
  recoveryAttempts Int             @default(0) @map("recovery_attempts")
  recoveryStartedAt DateTime?      @map("recovery_started_at")
  recoveryNextAttemptAt DateTime?  @map("recovery_next_attempt_at")
  recoveryAcknowledgedAt DateTime? @map("recovery_acknowledged_at")
  recoveryLastError String?         @map("recovery_last_error")
  errorMessage    String?          @map("error_message")
  lastMessageAt   DateTime?        @map("last_message_at")
  startedAt       DateTime?        @map("started_at")
  endedAt         DateTime?        @map("ended_at")
  deletedAt       DateTime?        @map("deleted_at")
  createdByUserId String?          @map("created_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  createdBy       User?            @relation("StreamCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  messages        ChatMessage[]
  sessions        CaptureSession[]

  @@index([status])
  @@index([videoId])
  @@index([lastMessageAt])
  @@map("streams")
}

model ChatAuthor {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorChannelId String?       @unique @map("author_channel_id")
  displayName     String        @map("display_name")
  avatarUrl       String?       @map("avatar_url")
  firstSeenAt     DateTime      @default(now()) @map("first_seen_at")
  lastSeenAt      DateTime      @default(now()) @map("last_seen_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  messages        ChatMessage[]
  userUpdateWatches UserUpdateWatch[]
  notificationEvents NotificationEventUser[]

  @@index([displayName])
  @@map("chat_authors")
}

model UserUpdateWatch {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  authorId  String     @map("author_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  author    ChatAuthor @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([userId, authorId])
  @@index([userId, createdAt])
  @@index([authorId])
  @@map("user_update_watches")
}

model ChatMessage {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId       String      @map("message_id")
  streamId        String      @map("stream_id") @db.Uuid
  videoId         String      @map("video_id")
  authorId        String?     @map("author_id") @db.Uuid
  authorChannelId String?     @map("author_channel_id")
  authorName      String      @map("author_name")
  authorAvatarUrl String?     @map("author_avatar_url")
  messageText     String      @map("message_text")
  messageType     MessageType @default(NORMAL) @map("message_type")
  badges          Json?
  amount          Decimal?    @db.Decimal(12, 2)
  currency        String?
  originalTimestamp DateTime? @map("original_timestamp")
  capturedAt      DateTime    @default(now()) @map("captured_at")
  rawPayload      Json        @map("raw_payload")
  stream          Stream      @relation(fields: [streamId], references: [id], onDelete: Cascade)
  author          ChatAuthor? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  notificationDeliveries NotificationDelivery[]

  @@unique([streamId, messageId])
  @@index([streamId])
  @@index([videoId])
  @@index([authorName])
  @@index([authorChannelId])
  @@index([capturedAt])
  @@index([messageType])
  @@index([authorId, capturedAt, id], map: "chat_messages_author_session_idx")
  @@map("chat_messages")
}

model NotificationEvent {
  id              String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  isEnabled       Boolean                   @default(true) @map("is_enabled")
  createdById     String?                   @map("created_by_id") @db.Uuid
  lastTriggeredAt DateTime?                 @map("last_triggered_at")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")
  createdBy       User?                     @relation("NotificationEventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  users           NotificationEventUser[]
  deliveries      NotificationDelivery[]

  @@index([isEnabled, createdAt])
  @@index([lastTriggeredAt])
  @@map("notification_events")
}

model NotificationEventUser {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String            @map("event_id") @db.Uuid
  authorId  String            @map("author_id") @db.Uuid
  createdAt DateTime          @default(now()) @map("created_at")
  event     NotificationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author    ChatAuthor        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([eventId, authorId])
  @@index([authorId])
  @@map("notification_event_users")
}

model NotificationDelivery {
  id            String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId       String                     @map("event_id") @db.Uuid
  chatMessageId String                     @map("chat_message_id") @db.Uuid
  status        NotificationDeliveryStatus @default(PENDING)
  errorMessage  String?                    @map("error_message")
  attemptedAt   DateTime?                  @map("attempted_at")
  sentAt        DateTime?                  @map("sent_at")
  createdAt     DateTime                   @default(now()) @map("created_at")
  event         NotificationEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  message       ChatMessage                @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)

  @@unique([eventId, chatMessageId])
  @@index([status])
  @@index([createdAt])
  @@map("notification_deliveries")
}

model PushDevice {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  token        String   @unique
  name         String
  userAgent    String?  @map("user_agent")
  isEnabled    Boolean  @default(true) @map("is_enabled")
  lastSeenAt   DateTime @default(now()) @map("last_seen_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isEnabled])
  @@index([lastSeenAt])
  @@map("push_devices")
}

model CaptureSession {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  streamId     String               @map("stream_id") @db.Uuid
  workerId     String               @map("worker_id")
  status       CaptureSessionStatus @default(RUNNING)
  startedAt    DateTime             @default(now()) @map("started_at")
  endedAt      DateTime?            @map("ended_at")
  heartbeatAt  DateTime             @default(now()) @map("heartbeat_at")
  errorMessage String?              @map("error_message")
  stream       Stream               @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@index([streamId])
  @@index([workerId])
  @@index([status])
  @@map("capture_sessions")
}

model ExportJob {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdById   String?         @map("created_by_id") @db.Uuid
  status        ExportJobStatus @default(PENDING)
  format        ExportFormat
  type          ExportJobType
  filters       Json
  filePath      String?         @map("file_path")
  fileName      String?         @map("file_name")
  errorMessage  String?         @map("error_message")
  createdAt     DateTime        @default(now()) @map("created_at")
  completedAt   DateTime?       @map("completed_at")
  createdBy     User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@map("export_jobs")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User?    @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("system_settings")
}
